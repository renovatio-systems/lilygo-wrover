# LilyGo T-Call (ESP32-WROVER-B module) with 4 MB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Bluetooth: Bluedroid host, BLE only (WiFi and BLE share the radio).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_BLE_SMP_ENABLE=y

# Fire TV uses a self-signed HTTPS certificate on port 8080. Skip server
# certificate verification for all TLS in this firmware (no CA is configured).
# SKIP_SERVER_CERT_VERIFY only exists when ESP_TLS_INSECURE is enabled.
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
